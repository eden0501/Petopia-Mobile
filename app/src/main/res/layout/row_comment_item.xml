<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal"
    android:gravity="start">

    <ImageView
        android:id="@+id/imageCommentAuthor"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_stub_avatar"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:background="@drawable/bg_comment_bubble"
        android:padding="12dp">

        <TextView
            android:id="@+id/textCommentAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/black"
            tools:text="Ruth_DogMom" />

        <TextView
            android:id="@+id/textComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="@color/text_body"
            tools:text="I can help! DMing you now with my contact info." />

        <TextView
            android:id="@+id/textCommentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            tools:text="about 2 months ago" />
    </LinearLayout>

</LinearLayout>
