<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_100"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- App Bar -->
    <include
        android:id="@+id/includeAppBar"
        layout="@layout/layout_top_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile picture section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="24dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfilePicture"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_stub_avatar"
                    android:scaleType="centerCrop"
                    android:contentDescription="Profile picture"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:strokeColor="@color/white"
                    app:strokeWidth="3dp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/gray_100" />

            <!-- Form fields -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/LabelStyle"
                    android:layout_marginTop="0dp"
                    android:text="@string/username_label" />

                <EditText
                    android:id="@+id/etUsername"
                    style="@style/InputStyle"
                    android:hint="@string/username_hint"
                    android:inputType="text"
                    tools:text="Danielle_Volunteer" />

                <TextView
                    style="@style/LabelStyle"
                    android:text="@string/email_label" />

                <EditText
                    android:id="@+id/etEmail"
                    style="@style/InputStyle"
                    android:enabled="false"
                    android:hint="@string/email_hint"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_secondary"
                    tools:text="danielle@example.com" />

                <TextView
                    style="@style/LabelStyle"
                    android:text="@string/pet_count_label" />

                <EditText
                    android:id="@+id/etPetCount"
                    style="@style/InputStyle"
                    android:hint="@string/pet_count_hint"
                    android:inputType="number" />

                <TextView
                    style="@style/LabelStyle"
                    android:text="@string/owner_since_label" />

                <EditText
                    android:id="@+id/etOwnerSince"
                    style="@style/InputStyle"
                    android:focusable="false"
                    android:clickable="true"
                    android:hint="@string/owner_since_hint" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/petopia_orange"
                    android:text="@string/save_changes"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/gray_100" />

            <!-- Danger zone: Logout + Delete -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="20dp">

                <Button
                    android:id="@+id/btnLogout"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/logout"
                    android:textColor="@color/text_primary"
                    app:strokeColor="@color/gray_200" />

                <Button
                    android:id="@+id/btnDeleteAccount"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/delete_account"
                    android:textColor="@color/rescue_red" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
