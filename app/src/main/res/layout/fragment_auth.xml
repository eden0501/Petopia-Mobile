<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/authFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="60dp"
        android:src="@drawable/ic_paw_logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_subtitle"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/authTabLayout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/tab_background"
        app:tabIndicator="@drawable/tab_selector"
        app:tabIndicatorColor="@null"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorGravity="stretch"
        app:tabIndicatorHeight="50dp"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="@color/text_primary"
        app:tabTextColor="@color/text_secondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_tab" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/signup_tab" />
    </com.google.android.material.tabs.TabLayout>


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvFormTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_back"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFormDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_description"
                android:textColor="@color/text_secondary" />

            <TextView
                style="@style/LabelStyle"
                android:text="@string/email_address_label" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/InputStyle"
                android:hint="@string/email_example_hint"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/LabelStyle"
                android:text="@string/password_label" />

            <EditText
                android:id="@+id/etPassword"
                style="@style/InputStyle"
                android:hint="@string/password_hint"
                android:inputType="textPassword" />

            <LinearLayout
                android:id="@+id/signupExtraFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/LabelStyle"
                            android:text="@string/username_label" />

                        <EditText
                            android:id="@+id/etUsername"
                            style="@style/InputStyle"
                            android:hint="@string/unique_name_hint" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/profileImageContainer"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivProfilePicture"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/tab_background"
                            android:paddingLeft="12dp"
                            android:paddingTop="12dp"
                            android:src="@drawable/ic_user_profile"
                            app:shapeAppearanceOverlay="@style/CircleImage"
                            app:strokeColor="@color/white"
                            app:strokeWidth="2dp" />

                        <FrameLayout
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_camera_badge">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_camera"
                                android:contentDescription="@string/change_photo" />
                        </FrameLayout>
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/LabelStyle"
                            android:text="@string/pets_label" />

                        <EditText
                            android:id="@+id/etPetCount"
                            style="@style/InputStyle"
                            android:hint="@string/pet_count_zero_hint"
                            android:inputType="number" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/LabelStyle"
                            android:text="@string/since_label" />

                        <EditText
                            android:id="@+id/etOwnerSince"
                            style="@style/InputStyle"
                            android:focusable="false"
                            android:hint="@string/select_date"
                            android:inputType="none" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/button_primary"
                android:text="@string/login_tab"
                android:textAllCaps="false" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>